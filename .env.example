# ─────────────────────────────────────────────────────────────
# Vault Co — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must never be committed.
# See docs/environment-variables.md for full documentation.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# AI Provider (Veronica)
# Options: mock | anthropic | openai
# Default: mock (no API key required — uses built-in templates)
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=mock

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Supabase — Database & Storage
# Leave blank to run fully on mock data (no database required).
# Fill in all three to activate the Supabase data provider.
# See docs/supabase-setup.md for setup instructions.
# NEVER commit SUPABASE_SERVICE_ROLE_KEY — it bypasses RLS.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Meta Ads — FUTURE (do NOT connect until human approval gate is live)
# Leave blank. These are placeholders only.
# Live Meta publishing is blocked by design until approval workflow
# is fully implemented and reviewed by the Vault Co team.
# ─────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────
# GoHighLevel — FUTURE (do NOT connect until human approval gate is live)
# Leave blank. These are placeholders only.
# ─────────────────────────────────────────────────────────────
GHL_API_KEY=
GHL_LOCATION_ID=

# ─────────────────────────────────────────────────────────────
# Stripe — Draft Invoice Creation (Phase 2E)
# Secret key from the Stripe Dashboard (sk_live_... or sk_test_...).
# Server-side only — NEVER prefix with NEXT_PUBLIC_.
# Add to Vercel environment variables. Leave blank locally to get
# a 503 from the create-invoice-draft endpoint instead of a crash.
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Victoria AI Sales Coach — Redis Session State (Upstash)
# Required for live call session state management.
# Falls back to in-memory store when absent (dev only).
# Get credentials at: https://console.upstash.com
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────
# Victoria — Live Transcription (AssemblyAI)
# Server-side only — NEVER use NEXT_PUBLIC_ prefix.
# The server exchanges this key for a short-lived token;
# only the token is sent to the browser. Key stays on server.
# Get your key at: https://www.assemblyai.com
# Falls back to Web Speech API (Chrome only) when absent.
# ─────────────────────────────────────────────────────────────
ASSEMBLYAI_API_KEY=
